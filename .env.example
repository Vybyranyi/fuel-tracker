# Скопіюй у .env.local і заповни. .env.local у .gitignore — секрети в репозиторій не потрапляють.
#
# На Verselі ці ж змінні задаються в Project Settings → Environment Variables.
# Локально найшвидше витягнути їх звідти: `vercel env pull .env.local`.

# Рядок підключення до Neon Postgres.
# Vercel → Storage → твоя база → .env.local / Connection string.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Чотири цифри, якими відкривається застосунок.
AUTH_PIN="2006"

# Ключ для підпису сесійної куки. Щонайменше 32 символи.
# Згенерувати: openssl rand -base64 32
AUTH_SESSION_SECRET="змінити-на-власний-рядок-щонайменше-32-символи"

# Секрет для щоденного крону. Vercel сам шле його заголовком
# Authorization: Bearer <значення> при запуску задачі з vercel.json.
# Без цієї змінної ендпоінт /api/cron/daily відповідає 401 і не робить нічого.
# Згенерувати: openssl rand -base64 32
CRON_SECRET="змінити-на-власний-рядок"

# Пуш-сповіщення (VAPID). Згенерувати пару: npx web-push generate-vapid-keys
#
# Публічний ключ навмисно лише в NEXT_PUBLIC_-змінній: він потрібен і браузеру,
# і серверу, а публічний за визначенням. Друга, серверна копія того самого
# значення давала б лише спосіб їм розійтися — і мовчазні відмови push-сервісу.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Контакт для push-сервісу — mailto: або https://. За стандартом сервіс має
# кому написати, якщо розсилка почне поводитись погано.
VAPID_SUBJECT="mailto:mariankvit@gmail.com"

# Вивантаження місячного підсумку в Google Sheets.
#
# Що зробити один раз:
#  1. console.cloud.google.com → новий проєкт → APIs & Services → увімкнути
#     Google Sheets API.
#  2. Credentials → Create credentials → Service account. Ключ у форматі JSON.
#  3. Відкрити свою таблицю → «Надати доступ» → вписати email сервісного
#     акаунта з ролью «Редактор». Без цього кроку буде 403: акаунт існує, але
#     до конкретної таблиці доступу не має.
GOOGLE_SERVICE_ACCOUNT_EMAIL="назва@проєкт.iam.gserviceaccount.com"

# Поле private_key з того ж JSON, разом із -----BEGIN PRIVATE KEY-----.
# У Vercel вставляється як є, з переносами рядків: код розуміє і \n, і справжні.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Ідентифікатор таблиці — шматок URL між /d/ і /edit.
GOOGLE_SHEETS_SPREADSHEET_ID=""

# Назва аркуша. Якщо його немає, сервіс створить його разом із шапкою.
GOOGLE_SHEETS_TAB_NAME="Пальне"
