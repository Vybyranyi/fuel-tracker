# Скопіюй у .env.local і заповни. .env.local у .gitignore — секрети в репозиторій не потрапляють.
#
# На Verselі ці ж змінні задаються в Project Settings → Environment Variables.
# Локально найшвидше витягнути їх звідти: `vercel env pull .env.local`.

# Підключення до Postgres на Supabase.
# Supabase → Project Settings → Database → Connection string.
#
# Там три варіанти, і вони не взаємозамінні:
#
#  * Transaction pooler, порт 6543 — для застосунку. Роздає одне зʼєднання
#    різним запитам, тому переживає десятки паралельних функцій на Vercel.
#  * Session pooler, порт 5432 — для міграцій. Тримає зʼєднання за тобою, тож
#    підготовлені запити drizzle-kit працюють. Доступний і по IPv4.
#  * Direct connection, db.<ref>.supabase.co — теж підходить для міграцій, але
#    він тільки по IPv6: з багатьох домашніх мереж просто не відкриється.
#
# Через транзакційний пулер міграції падають на «prepared statement already
# exists» — саме тому змінних дві.
DATABASE_URL="postgresql://postgres.<ref>:<пароль>@aws-0-<регіон>.pooler.supabase.com:6543/postgres"

# Те саме, але session pooler (порт 5432). Читає лише drizzle-kit — у самому
# застосунку не використовується. Без неї міграції підуть через DATABASE_URL.
DIRECT_URL="postgresql://postgres.<ref>:<пароль>@aws-0-<регіон>.pooler.supabase.com:5432/postgres"

# Адреса проєкту Supabase і публічний ключ.
# Supabase → Project Settings → API keys → ключ виду sb_publishable_…
#
# Обидва в NEXT_PUBLIC_, бо потрібні і серверу, і браузеру. Публічний ключ і
# має бути публічним: доступ до даних регулює не він, а політики RLS у базі.
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Секрет для щоденного крону. Vercel сам шле його заголовком
# Authorization: Bearer <значення> при запуску задачі з vercel.json.
# Без цієї змінної ендпоінт /api/cron/daily відповідає 401 і не робить нічого.
# Згенерувати: openssl rand -base64 32
CRON_SECRET="змінити-на-власний-рядок"

# Пуш-сповіщення (VAPID). Згенерувати пару: npx web-push generate-vapid-keys
#
# Публічний ключ навмисно лише в NEXT_PUBLIC_-змінній: він потрібен і браузеру,
# і серверу, а публічний за визначенням. Друга, серверна копія того самого
# значення давала б лише спосіб їм розійтися — і мовчазні відмови push-сервісу.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Контакт для push-сервісу — mailto: або https://. За стандартом сервіс має
# кому написати, якщо розсилка почне поводитись погано.
VAPID_SUBJECT="mailto:mariankvit@gmail.com"
